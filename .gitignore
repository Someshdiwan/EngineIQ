cat > .gitignore << 'EOF'
# Dependencies
node_modules/
frontend/node_modules/

# Build output
dist/
frontend/dist/

# Environment files
.env
.env.local
.env.production

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Java/Maven (for later)
target/
*.class
*.jar
*.war

# Logs
*.log
npm-debug.log*
EOF

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vite/
frontend/.vite/
